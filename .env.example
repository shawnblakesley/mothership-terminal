# Copy to .env and fill in whichever keys you have. You only need one.
# A new session defaults to the cheapest model you have a key for
# (DeepSeek Flash, then Claude Haiku 4.5); switch any time from the DM console.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# DM_KEY=secret      # DM console then requires /dm?key=secret
# PORT=3000
