# Copy to .env for local settings. Everything is optional.
#
# API keys are entered by each Warden in the console when they start a session;
# they are kept in memory only. The server needs no keys of its own.

# Serve under a sub-path, e.g. /mothership for https://example.com/mothership/
# BASE_PATH=
# PORT=3000
# DATA_DIR=./data            # where sessions are saved
# SESSION_TTL_DAYS=14        # idle sessions are deleted after this
# MAX_SESSIONS=300
# TELEMETRY=0               # don't send usage counts to a local CloudWatch agent (see README)

# Offer "Free (shared)" on the start screen: OpenRouter's free models, on this key.
# Safe on a public server (free models cost nothing); they share one rate limit.
# OPENROUTER_API_KEY=
# FREE_CALLS_PER_DAY=150     # per session

# A Discord bot that writes down what's said in a voice channel, into a session's
# log (like the Warden's Listen button, but for everyone, by name). Make an app at
# https://discord.com/developers/applications, add a bot, and paste its token
# here; the server log prints the link to invite it. Each Warden adds a Groq key
# (for the speech-to-text) in the console under Settings, Discord.
# DISCORD_BOT_TOKEN=
# DISCORD_STT_LANGUAGE=en    # what's spoken; empty = Whisper guesses
# DISCORD_STT_MODEL=whisper-large-v3-turbo

# Private LAN use only: let sessions without their own key use these.
# Never enable this on a public server, or anyone can spend your credit.
# ALLOW_SERVER_KEYS=1
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
