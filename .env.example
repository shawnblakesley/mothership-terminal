# Copy to .env for local settings. Everything is optional.
#
# API keys are entered by each Warden in the console when they start a session;
# they are kept in memory only. The server needs no keys of its own.

# Serve under a sub-path, e.g. /mothership for https://example.com/mothership/
# BASE_PATH=
# PORT=3000
# DATA_DIR=./data            # where sessions are saved
# SESSION_TTL_DAYS=14        # idle sessions are deleted after this
# MAX_SESSIONS=300

# Private LAN use only: let sessions without their own key use these.
# Never enable this on a public server, or anyone can spend your credit.
# ALLOW_SERVER_KEYS=1
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
